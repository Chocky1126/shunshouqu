<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/pixel_parcel"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_preview_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/widget_name"
            android:textColor="#33291E"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_total"
            android:textColor="#7A6A57"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetPickupRow"
        android:visibility="visible">
        <TextView style="@style/WidgetCode" android:text="@string/widget_preview_code_first" />
        <TextView style="@style/WidgetStation" android:text="@string/widget_preview_station_first" />
        <TextView style="@style/WidgetDone" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetPickupRow"
        android:visibility="visible">
        <TextView style="@style/WidgetCode" android:text="@string/widget_preview_code_second" />
        <TextView style="@style/WidgetStation" android:text="@string/widget_preview_station_second" />
        <TextView style="@style/WidgetDone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_preview_filler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="@string/widget_open_app"
        android:textColor="#B34B16"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
